{
  "name": "openflow",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop voice transcription tool with offline Whisper transcription and Google AI cleanup.",
  "main": "dist-electron/electron/main.js",
  "author": "OpenAI Codex",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/sync-windows-runtime.mjs && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "model:download": "node scripts/download-model.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.openflow.desktop",
    "productName": "Openflow",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "resources/icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bin",
        "to": "resources/bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/whispercpp",
        "to": "resources/whispercpp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/icons/openflow.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "resources/icons/openflow.ico",
      "uninstallerIcon": "resources/icons/openflow.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
